##remaining, cleaning and selecting columns
clinic_clean =
  clinic_raw %>%
  rename(id = patient_id)

clinic_clean = 
  clinic_clean %>%
  select(id, site, sex, age, visit_date, blood_pressure, weight_kg, notes)

clinic_clean = 
  clinic_clean %>%
  filter(age >= 18 | is.na(age)) ##keep adults, do not drop missing ages

##Sorting rows
clinic_clean %>% arrange(age) %>% head() ##youngest patients first

clinic_clean %>% arrange(desc(age)) %>% head() ##descending order, oldest patients first

##Grouped summaries
clinic_clean %>%
  group_by(site) %>%
  summarise(
    mean_age = mean(age, na.rm = TRUE)
    , n = n() # count number of rows in each group
    
  )

##Cleaning up text
clinic_clean = 
  clinic_clean %>%
  mutate(
    site = tolower(trimws(site)) #lowercase + strip whitespace
    , site = gsub("_", " ", site) #replace "_" with " "
  )

table(clinic_clean$site)
substring("PT-0001", 4, 7) #characters 4 through 7: "0001"

##Regular expressions
library(stringr)
clinic_clean = clinic_clean %>%
  mutate(
    bp_upper = as.numeric(str_extract(blood_pressure, "^[0-9]+")) ## digits before the "/" in e.g. 120/80 mmHg
    , bp_lower = as.numeric(str_extract(blood_pressure, "(?<=/)[0-9]+")) ## digits after the "/"
  )

head(clinic_clean[, c("blood_pressure", "bp_upper")])

gsub("[^0-9.]", "", "72.5 kg") #strip everything except digits and "."

grep("follow", clinic_clean$notes, ignore.case = TRUE) # ignore.case catches "FOLLOW UP" and "follow up" in notes column

clinic_clean %>% filter(grepl("follow", notes, ignore.case = TRUE)) #filter by ignoring cells in notes column with the word "follow"

clinic_clean =
  clinic_clean %>%
  mutate(
    weight_kg = na_if(weight_kg, "-")
    , weight_kg = as.numeric(weight_kg)
    , visit_date = as.Date(visit_date, format = "%d/%m/%Y") ##dd/mm/yyyy text
  )
head(clinic_clean)

#Conditional logic
clinic_clean =
  clinic_clean %>%
  mutate(
    sex = ifelse(
      toupper(sex) == "M", "Male"
      , ifelse(toupper(sex) == "F", "Female", NA) # nested ifelse for the third outcome
    )
  )

clinic_clean = 
  clinic_clean %>%
  mutate(
    bp_category = case_when(
      is.na(bp_upper) ~ NA_character_ #keep missing values as missing
      , bp_upper < 120 ~ "Normal"
      , bp_upper < 140 ~ "Elevated"
      , TRUE ~ "High" #catch-all for remaining values
    )
  )
table(clinic_clean$bp_category, useNA = "always")

#Writing own functions
clean_text = function(x) {
  x = trimws(x) #strip whitespace
  x = tolower(x) #standardise case
  x}
clean_text("FOLLOW UP")

clinic_clean =
  clinic_clean %>%
  mutate(notes = clean_text(notes)) #reuse the function on the notes column
table(clinic_clean$notes, useNA = "always")

##Reshaping data
clinic_clean %>%
  select(id, bp_upper, bp_lower) %>%
  head(4) %>%
  tidyr::pivot_longer(
    cols = c(bp_upper, bp_lower) # the two columns to stack
    , names_to = "reading" # new column naming which reading it was
    , values_to = "value" # new column holding the actual number
  )

clinic_clean %>%
  group_by(site, sex) %>%
  summarise(mean_age = mean(age, na.rm = TRUE), .groups = "drop") %>%
  tidyr::pivot_wider(names_from = sex, values_from = mean_age)

#Combine dataset
site_lookup = data.frame(
  site = c("site a", "site b", "site c", "site d")
  , region = c("North", "North", "South", "South")
)

clinic_clean =
  clinic_clean %>%
  left_join(site_lookup, by = "site") #attach region, keep every clinic_clean row
head(clinic_clean)

## Pipes %>% vs |>
clinic_clean %>%filter(bp_category == "High") %>% nrow()
clinic_clean |> filter(bp_category == "High") |> nrow()
##>same behaviour 

write_csv(clinic_clean, "data/clinic_clean.csv")
